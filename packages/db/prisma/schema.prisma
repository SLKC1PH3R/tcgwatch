// TCGWatch — schéma de données
// Prisma 7 : l'URL de connexion est fournie par prisma.config.ts (DATABASE_URL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum ProductType {
  ETB
  DISPLAY
  TRIPACK
  BOOSTER
  BLISTER
  COFFRET
  UPC
  MINI_TIN
  POKEBOX
  DECK
  AUTRE
}

enum ReleaseStatus {
  AUTO
  VALIDATED
}

enum ReleaseSource {
  TCGDEX
  POKECARDEX
  RETAILER
  MANUAL
  SEED
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

enum ListingState {
  ACTIVE
  PAUSED
  ERROR
  BLOCKED_BY_ROBOTS
}

enum AlertType {
  BACK_IN_STOCK
  PREORDER_OPEN
  PRICE_TARGET
  RELEASE_DATE
  NEW_LOW /// nouveau plus bas historique du meilleur prix achetable
  MARKET_MOVE /// variation du prix marché sur 7 jours au-delà du seuil
  CARD_PRICE /// cote d'une carte suivie passée sous / au-dessus de son seuil
  MARKET_DEAL /// annonce de particulier (eBay) ou cote Cardmarket sous le « bon prix »
}

enum RetailerKind {
  SPECIALIST /// boutique de jeux / cartes
  CULTURE /// grande enseigne culturelle
  TOYS /// magasin de jouets
  SUPERMARKET /// hyper / place de marché généraliste
  OTHER
}

/// Capacité de TCGWatch à relever les fiches du site.
enum RetailerAccess {
  OK /// relevé HTTP simple vérifié
  BROWSER /// nécessite Chromium (Playwright), sans garantie
  LIMITED /// protection anti-bot : relevés souvent bloqués
  UNTESTED /// adaptateur générique, non vérifié
}

enum SealCondition {
  MINT
  NEAR_MINT
  DAMAGED
  OPENED
}

// ─── Authentification ────────────────────────────────────

enum Role {
  USER
  /// Gère le catalogue, les boutiques, les signalements ; reçoit toutes les alertes produit.
  ADMIN
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  /// Null pour un compte créé avec Google.
  passwordHash    String?
  role            Role             @default(USER)
  /// E-mail confirmé (lien reçu par e-mail, ou compte Google).
  emailVerifiedAt DateTime?
  /// Identifiant Google (« sub ») du compte lié.
  googleId        String?          @unique
  sessions        Session[]
  tokens          AuthToken[]
  follows         ProductFollow[]
  collection      CollectionItem[]
  ownedCards      OwnedCard[]
  binders         CardBinder[]
  showcases       Showcase[]
  alertSettings   AlertSettings?
  alerts          AlertEvent[]
  pushDevices     PushSubscription[]
  reports         ErrorReport[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum ReportKind {
  /// Prix faux (mauvais montant, prix d'un autre format…)
  PRICE
  /// Stock faux (annoncé en stock, épuisé, précommande…)
  STOCK
  /// Fiche rattachée au mauvais produit (accessoire, autre extension…)
  MATCH
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// Erreur signalée par un utilisateur sur un prix, un stock ou un rapprochement.
model ErrorReport {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ReportKind
  productId  String?
  listingId  String?
  cardId     String?
  /// Page d'où vient le signalement.
  path       String?
  message    String
  status     ReportStatus @default(OPEN)
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
}

/// Appareil abonné aux notifications du navigateur (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Navigateur et appareil (affichés dans les réglages).
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Jeton à usage unique envoyé par e-mail ; l'identifiant est le SHA-256 du jeton brut.
model AuthToken {
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

/// Produit suivi par un utilisateur (« Mes produits ») : son bon prix et ses alertes coupées.
/// Product.targetPrice garde le plus haut bon prix des suiveurs (déclencheur des alertes).
model ProductFollow {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Decimal?    @db.Decimal(10, 2)
  mutedAlerts AlertType[] @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

/// L'identifiant est le SHA-256 du jeton envoyé dans le cookie (le jeton brut n'est jamais stocké).
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Module 1 — Calendrier des sorties ───────────────────

/// Série (génération) TCGdex : Méga-Évolution, Écarlate et Violet… L'ordre suit TCGdex
/// (0 = la plus ancienne).
model Serie {
  id        String    @id /// id TCGdex (ex. "me")
  name      String
  logoUrl   String?
  order     Int
  releases  Release[]
  updatedAt DateTime  @updatedAt
}

model Release {
  id                String        @id @default(cuid())
  nameFr            String
  setCode           String? /// ex. "ME06"
  tcgdexId          String?       @unique /// id du set TCGdex (ex. "me06")
  externalId        String?       @unique /// id dans une autre source (ex. "pokecardex:3382")
  msrp              Decimal?      @db.Decimal(10, 2) /// prix public conseillé annoncé
  serie             String? /// ex. "Méga-Évolution"
  releaseDate       DateTime?     @db.Date
  productType       ProductType? /// null = l'extension elle-même
  imageUrl          String?
  source            ReleaseSource @default(MANUAL)
  sourceUrl         String?
  status            ReleaseStatus @default(AUTO)
  notes             String?
  /// Extension TCGdex : série, symbole, nombre de cartes (officielles / total avec secrètes).
  serieId           String?
  serieRef          Serie?        @relation(fields: [serieId], references: [id], onDelete: SetNull)
  symbolUrl         String?
  cardCountOfficial Int?
  cardCountTotal    Int?
  /// Dernier import de la liste des cartes.
  cardsSyncedAt     DateTime?
  products          Product[]     @relation("ProductRelease")
  /// Produits scellés de cette extension (Product.extensionId).
  extensionProducts Product[]     @relation("ProductExtension")
  cards             Card[]
  chaseCards        ChaseCard[]
  binders           CardBinder[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([releaseDate])
  @@index([serieId])
}

// ─── Module 2 — Produits, revendeurs, relevés ────────────

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  externalId        String?          @unique /// ex. "pokecardex:3382" (catalogue importé)
  type              ProductType
  ean               String?          @unique
  imageUrl          String?
  images            String[]         @default([]) /// galerie (fiches revendeurs), imageUrl en tête
  description       String?
  brand             String?
  msrp              Decimal?         @db.Decimal(10, 2) /// prix public conseillé
  /// Plus haut bon prix des utilisateurs qui suivent le produit (tenu à jour par le site) :
  /// déclenche les alertes de prix, filtrées ensuite par le bon prix de chacun.
  targetPrice       Decimal?         @db.Decimal(10, 2)
  follows           ProductFollow[]
  releaseDate       DateTime?        @db.Date /// date propre au produit (ex. "Sortie prévue le" revendeur)
  releaseDateSource ReleaseSource?
  notes             String?
  releaseId         String?
  release           Release?         @relation("ProductRelease", fields: [releaseId], references: [id], onDelete: SetNull)
  /// Identifiant du produit Cardmarket (via CardNexus) : guide des prix officiel quotidien.
  cardmarketId      Int?
  /// Nom du produit sur Cardmarket (anglais), pour la recherche sur le site.
  cardmarketName    String?
  /// Catégorie Cardmarket (« Pokémon Display »…) : adresse de la fiche produit sur le site.
  cardmarketCategory String?
  /// Mots-clés des recherches d'annonces (eBay, Leboncoin, Vinted) ; sinon le nom du produit.
  marketQuery       String?
  secondhandDaily   SecondhandDaily[]
  marketListings    MarketListing[]
  /// Extension TCGdex du produit (calculée à l'import d'après le nom et la date).
  extensionId       String?
  extension         Release?         @relation("ProductExtension", fields: [extensionId], references: [id], onDelete: SetNull)
  listings          Listing[]
  marketPrices      MarketPrice[]
  collection        CollectionItem[]
  alerts            AlertEvent[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([releaseId])
  @@index([extensionId])
}

model Retailer {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  domain           String         @unique /// domaine sans "www." (ex. "play-in.com")
  adapterKey       String /// "playin" | "philibert" | "cultura" | "smyths" | "jsonld"
  minDelayMs       Int            @default(3000)
  enabled          Boolean        @default(true)
  kind             RetailerKind   @default(OTHER)
  access           RetailerAccess @default(UNTESTED)
  websiteUrl       String?
  pokemonUrl       String? /// page « Pokémon » ou recherche du site
  searchUrl        String? /// modèle de recherche, « {q} » = termes recherchés
  notes            String?
  /// Frais de port d'un colis standard en France (null = inconnu, 0 = toujours offert).
  shippingCost     Decimal?       @db.Decimal(10, 2)
  /// Montant de commande à partir duquel le port est offert (null = jamais / inconnu).
  freeShippingFrom Decimal?       @db.Decimal(10, 2)
  /// Frais de port saisis sur le site : l'annuaire ne les écrase plus.
  shippingManual   Boolean        @default(false)
  listings         Listing[]
}

model Listing {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailerId        String
  retailer          Retailer       @relation(fields: [retailerId], references: [id])
  url               String         @unique
  stockAlertUrl     String?
  targetPrice       Decimal?       @db.Decimal(10, 2) /// prioritaire sur Product.targetPrice
  checkIntervalMin  Int            @default(30)
  state             ListingState   @default(ACTIVE)
  nextCheckAt       DateTime       @default(now())
  lastCheckedAt     DateTime?
  /// Dernier relevé réussi (page lue, prix et stock extraits).
  lastSuccessAt     DateTime?
  // État dénormalisé (dernier relevé) pour des tableaux rapides
  lastTitle         String?
  lastImageUrl      String?
  discovered        Boolean        @default(false) /// fiche trouvée automatiquement (rayons revendeurs)
  sku               String? /// référence du revendeur
  category          String? /// rayon du site (fil d'Ariane)
  lastPrice         Decimal?       @db.Decimal(10, 2)
  lastCurrency      String         @default("EUR")
  lastAvailability  Availability   @default(UNKNOWN)
  lastInStockAt     DateTime?
  consecutiveErrors Int            @default(0)
  lastError         String?
  snapshots         Snapshot[]
  daily             ListingDaily[]
  alerts            AlertEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([state, nextCheckAt])
  @@index([productId])
}

model Snapshot {
  id           String       @id @default(cuid())
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price        Decimal?     @db.Decimal(10, 2)
  currency     String       @default("EUR")
  availability Availability
  releaseDate  DateTime?    @db.Date
  createdAt    DateTime     @default(now())

  @@index([listingId, createdAt])
  @@index([createdAt])
}

/// Résumé quotidien d'une fiche revendeur : alimenté à chaque relevé, il reste après la
/// purge des relevés détaillés (graphiques rapides sur de longues périodes).
model ListingDaily {
  id               String       @id @default(cuid())
  listingId        String
  listing          Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date             DateTime     @db.Date
  minPrice         Decimal?     @db.Decimal(10, 2)
  maxPrice         Decimal?     @db.Decimal(10, 2)
  lastPrice        Decimal?     @db.Decimal(10, 2)
  /// Plus bas prix relevé alors que le produit était achetable (en stock ou précommande).
  minBuyablePrice  Decimal?     @db.Decimal(10, 2)
  /// Achetable au moins une fois dans la journée.
  wasBuyable       Boolean      @default(false)
  lastAvailability Availability
  checks           Int          @default(0)
  /// Prix écarté automatiquement (< 50 % de la médiane 30 j ou du prix conseillé).
  suspect          Boolean      @default(false)
  /// Choix manuel sur le graphique (true = exclu, false = gardé), prioritaire sur `suspect`.
  excluded         Boolean?
  updatedAt        DateTime     @updatedAt

  @@unique([listingId, date])
  @@index([date])
}

/// Réglages des alertes (une seule ligne, id « default »).
model AlertSettings {
  id         String      @id @default(cuid())
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Heures silencieuses, en minutes depuis minuit (heure de Paris) ; null : désactivées.
  quietStart Int?
  quietEnd   Int?
  /// Types d'alertes journalisés mais jamais envoyés.
  mutedTypes AlertType[] @default([])
  updatedAt  DateTime    @updatedAt
}

model AlertEvent {
  id           String     @id @default(cuid())
  /// Destinataire : une alerte est journalisée une fois par utilisateur concerné.
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AlertType
  /// Produit concerné (null pour une alerte de carte).
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  chaseCardId  String?
  chaseCard    ChaseCard? @relation(fields: [chaseCardId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title        String
  message      String
  url          String?
  price        Decimal?   @db.Decimal(10, 2)
  dedupeKey    String
  sentNtfy     Boolean    @default(false)
  sentTelegram Boolean    @default(false)
  /// Envoyée en notification du navigateur (au moins un appareil).
  sentPush     Boolean    @default(false)
  acknowledged Boolean    @default(false)
  /// Envoyée sans son (heures silencieuses).
  silent       Boolean    @default(false)
  /// Journalisée mais pas envoyée : type coupé (partout ou pour ce produit).
  muted        Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([userId, acknowledged, createdAt])
  @@index([dedupeKey, createdAt])
  @@index([type, createdAt])
}

// ─── Module 3 — Marché secondaire ────────────────────────

/// Un relevé par jour, par produit et par source : l'historique se construit tout seul.
model MarketPrice {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  source       String /// "manual" | "poketrace" | ...
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @default("EUR")
  date         DateTime @db.Date
  /// Médiane des annonces, si la source la fournit.
  median       Decimal? @db.Decimal(10, 2)
  /// Nombre d'annonces prises en compte, si la source le fournit.
  listingCount Int?
  /// Guide des prix Cardmarket : prix le plus bas (« À partir de »), tendance, moyennes.
  low          Decimal? @db.Decimal(10, 2)
  trend        Decimal? @db.Decimal(10, 2)
  avg1         Decimal? @db.Decimal(10, 2)
  avg7         Decimal? @db.Decimal(10, 2)
  avg30        Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, source, date])
  @@index([productId, date])
}

/// Cartes phares d'une extension, suivies via le provider TCGdex.
/// Carte d'une extension (toutes les cartes, import TCGdex). La cote Cardmarket est un cache
/// d'environ 24 h lu à l'ouverture d'une page ; l'historique quotidien est réservé aux
/// cartes suivies (ChaseCard, même id TCGdex).
model Card {
  id                  String         @id /// id TCGdex (ex. "me06-130")
  releaseId           String
  release             Release        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  localId             String /// numéro dans l'extension (ex. "130", "TG05")
  number              Int? /// partie numérique du numéro, pour le tri
  name                String
  /// Pas de nom français dans TCGdex : `name` est le nom anglais.
  nameMissing         Boolean        @default(false)
  /// Image TCGdex sans suffixe (/low.webp, /high.webp) ; anglaise si la française manque.
  imageUrl            String?
  /// Empreinte perceptuelle (pHash) de l'illustration, pour le scanner de cartes.
  imageHash           String?
  /// Image d'où vient l'empreinte (recalculée si l'image change).
  imageHashUrl        String?
  rarity              String?
  illustrator         String?
  category            String? /// Pokémon, Dresseur, Énergie
  types               String[]       @default([])
  dexIds              Int[]          @default([])
  /// Variantes existantes : normal, reverse, holo, firstEdition.
  variants            String[]       @default([])
  priceTrend          Decimal?       @db.Decimal(10, 2)
  priceLow            Decimal?       @db.Decimal(10, 2)
  priceAvg30          Decimal?       @db.Decimal(10, 2)
  priceAvg7           Decimal?       @db.Decimal(10, 2)
  priceAvg1           Decimal?       @db.Decimal(10, 2)
  priceAt             DateTime?
  /// Produit Cardmarket de la carte (via TCGdex) : cote quotidienne tirée du guide des prix.
  cardmarketId        Int?
  /// Dernière recherche de l'id Cardmarket (évite de redemander une carte sans cote).
  cardmarketCheckedAt DateTime?
  updatedAt           DateTime       @updatedAt
  owned               OwnedCard[]
  binderEntries       BinderCard[]
  showcaseEntries     ShowcaseCard[]
  dailyPrices         CardPriceDaily[]

  @@index([releaseId, number])
  @@index([name])
  @@index([priceTrend])
  @@index([cardmarketId])
}

/// Valeur totale d'une famille de produits un jour donné (indice du marché) : cartes FR,
/// displays, ETB… Une ligne par jour et par famille, quelques Ko par an.
model MarketIndexSnapshot {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  key   String /// "cards" | "displays" | "etb" | "sealed"
  value Decimal  @db.Decimal(14, 2)
  count Int

  @@unique([date, key])
}

model ChaseCard {
  id         String       @id @default(cuid())
  releaseId  String
  release    Release      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  tcgdexId   String       @unique /// ex. "me06-130"
  name       String
  rarity     String?
  imageUrl   String?
  /// Suivie à la demande (recherche) plutôt que choisie automatiquement.
  manual     Boolean      @default(false)
  /// Seuils d'alerte sur la tendance Cardmarket (en euros).
  alertBelow Decimal?     @db.Decimal(10, 2)
  alertAbove Decimal?     @db.Decimal(10, 2)
  prices     CardPrice[]
  alerts     AlertEvent[]
  createdAt  DateTime     @default(now())
}

/// Cote Cardmarket quotidienne de chaque carte cotée (guide des prix) : historique de toutes
/// les cartes, pas seulement des cartes suivies.
model CardPriceDaily {
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  trend  Decimal? @db.Decimal(10, 2)
  low    Decimal? @db.Decimal(10, 2)
  avg7   Decimal? @db.Decimal(10, 2)
  avg30  Decimal? @db.Decimal(10, 2)

  @@id([cardId, date])
}

model CardPrice {
  id          String    @id @default(cuid())
  chaseCardId String
  chaseCard   ChaseCard @relation(fields: [chaseCardId], references: [id], onDelete: Cascade)
  source      String /// "tcgdex-cardmarket"
  /// Valeur affichée : tendance, à défaut moyenne 30 j ou moyenne.
  price       Decimal   @db.Decimal(10, 2)
  trend       Decimal?  @db.Decimal(10, 2)
  low         Decimal?  @db.Decimal(10, 2)
  avg7        Decimal?  @db.Decimal(10, 2)
  avg30       Decimal?  @db.Decimal(10, 2)
  currency    String    @default("EUR")
  date        DateTime  @db.Date

  @@unique([chaseCardId, source, date])
}

// ─── Module 4 — Ma collection ────────────────────────────

model CollectionItem {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int           @default(1)
  purchasePrice Decimal       @db.Decimal(10, 2) /// prix unitaire payé
  purchaseDate  DateTime      @db.Date
  store         String?
  /// Frais de port payés pour toute la ligne (répartis sur la quantité).
  shipping      Decimal?      @db.Decimal(10, 2)
  /// Revente : date, prix unitaire, frais (commission + port, pour toute la ligne), canal.
  soldAt        DateTime?     @db.Date
  salePrice     Decimal?      @db.Decimal(10, 2)
  saleFees      Decimal?      @db.Decimal(10, 2)
  saleChannel   String?
  condition     SealCondition @default(MINT)
  photoPath     String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([productId])
  @@index([userId])
}

/// Prix du marché de l'occasion, un résumé par jour et par source (annonces eBay neuves, en
/// achat immédiat, port compris) : la 3ᵉ courbe de la fiche produit.
model SecondhandDaily {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  source    String /// "ebay"
  date      DateTime @db.Date
  median    Decimal  @db.Decimal(10, 2)
  low       Decimal  @db.Decimal(10, 2)
  count     Int
  createdAt DateTime @default(now())

  @@unique([productId, source, date])
}

/// Annonce d'un particulier ou d'un vendeur sur une place de marché (eBay, API officielle),
/// trouvée pour un produit de « Mes produits » (produit avec un bon prix).
model MarketListing {
  id          String    @id @default(cuid())
  source      String /// "ebay"
  externalId  String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  price       Decimal   @db.Decimal(10, 2)
  shipping    Decimal?  @db.Decimal(10, 2)
  currency    String    @default("EUR")
  url         String
  imageUrl    String?
  condition   String?
  location    String?
  /// Remise en main propre proposée par le vendeur.
  localPickup Boolean   @default(false)
  /// Enchère (prix = enchère actuelle) plutôt qu'achat immédiat.
  auction     Boolean   @default(false)
  listedAt    DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@unique([source, externalId, productId])
  @@index([productId, firstSeenAt])
  @@index([firstSeenAt])
}

/// Cartes de la collection : une ligne par carte et par variante (normale, reverse…).
model OwnedCard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// normal, reverse, holo, firstEdition
  variant       String   @default("normal")
  quantity      Int      @default(1)
  purchasePrice Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, cardId, variant])
  @@index([userId, createdAt])
}

/// Classeur de cartes : celui d'une extension (toutes ses cartes, possédées ou manquantes)
/// ou un classeur personnel (cartes choisies une à une).
model CardBinder {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Extension du classeur (null = classeur personnel).
  releaseId   String?
  release     Release?     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  cards       BinderCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model BinderCard {
  id       String     @id @default(cuid())
  binderId String
  binder   CardBinder @relation(fields: [binderId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position Int        @default(0)

  @@unique([binderId, cardId])
  @@index([binderId, position])
}

/// Vitrine : sélection de cartes à montrer, partageable par un lien public (slug secret).
model Showcase {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Partie du lien public /vitrine/{slug} (aléatoire, impossible à deviner).
  slug        String         @unique
  /// Lien public actif.
  public      Boolean        @default(false)
  /// Afficher la cote des cartes sur la page publique.
  showPrices  Boolean        @default(false)
  /// Liste de recherche (« cartes que je cherche ») plutôt qu'une vitrine de cartes possédées.
  wanted      Boolean        @default(false)
  cards       ShowcaseCard[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
}

model ShowcaseCard {
  id         String   @id @default(cuid())
  showcaseId String
  showcase   Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([showcaseId, cardId])
  @@index([showcaseId, position])
}
