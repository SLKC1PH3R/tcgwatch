# ─────────────────────────────────────────────────────────────
# TCGWatch — variables d'environnement
# Copier ce fichier en `.env` (jamais commité) et adapter les valeurs.
# Dans Dokploy : onglet "Environment" de l'application Compose.
# ─────────────────────────────────────────────────────────────

# ── Général ──────────────────────────────────────────────────
NODE_ENV=development
# Fuseau horaire utilisé par les crons et l'affichage.
TZ=Europe/Paris
# URL publique de l'application (liens dans les notifications).
APP_URL=http://localhost:3000
# Domaine utilisé par les labels Traefik (docker-compose.yml).
APP_DOMAIN=tcg.digitalstack.cloud
# Niveau de log pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Base de données PostgreSQL ───────────────────────────────
# Identifiants du conteneur postgres du docker-compose (choisir un mot de passe fort).
POSTGRES_USER=tcgwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tcgwatch
# En local : localhost. Dans le compose, l'hôte est le service `postgres`.
# Pour une base gérée par Dokploy, remplacer par son "Internal Connection URL".
DATABASE_URL=postgresql://tcgwatch:change-me@localhost:5432/tcgwatch?schema=public

# ── Authentification ─────────────────────────────────────────
# L'inscription est toujours possible tant qu'aucun compte n'existe (premier utilisateur).
# Mettre à true pour autoriser d'autres inscriptions ensuite.
ALLOW_REGISTRATION=false
# Durée de vie d'une session (jours).
SESSION_TTL_DAYS=30
# Cookie "Secure" (HTTPS uniquement). Mettre à false uniquement en local sans HTTPS.
COOKIE_SECURE=false

# ── Notifications ────────────────────────────────────────────
# URL complète du topic ntfy (ex. https://ntfy.sh/mon-topic-secret ou instance self-hosted).
# Vide = notifications ntfy désactivées.
NTFY_URL=
# Jeton d'accès ntfy (optionnel, pour un topic protégé).
NTFY_TOKEN=
# Telegram (optionnel) : jeton du bot (@BotFather) et identifiant du chat destinataire.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Suivi des revendeurs ─────────────────────────────────────
# Intervalle par défaut entre deux relevés d'un même listing (minutes, min. 5).
DEFAULT_CHECK_INTERVAL_MIN=30
# User-agent envoyé aux sites (navigateur réaliste).
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
# Délai aléatoire entre deux requêtes vers un même domaine (ms).
SCRAPER_MIN_DELAY_MS=2000
SCRAPER_MAX_DELAY_MS=6000
# Timeout d'une requête (ms).
SCRAPER_TIMEOUT_MS=20000
# Autorise le repli sur Chromium (Playwright) pour les sites rendus en JavaScript.
PLAYWRIGHT_ENABLED=true

# ── Planification (syntaxe cron, fuseau = TZ) ────────────────
# Scrutation des listings arrivés à échéance.
LISTINGS_CRON=* * * * *
# Import quotidien des extensions depuis TCGdex.
TCGDEX_CRON=0 6 * * *
# Relevé quotidien des prix du marché secondaire.
MARKET_CRON=30 6 * * *
# Séries TCGdex importées (ids séparés par des virgules : me = Méga-Évolution, sv = Écarlate et Violet).
TCGDEX_SERIES=me,sv

# ── Marché secondaire (V2) ───────────────────────────────────
# Clé de l'API PokeTrace (payante). Vide = provider désactivé.
POKETRACE_API_KEY=
POKETRACE_API_URL=https://api.poketrace.com

# ── Worker ───────────────────────────────────────────────────
# Port du healthcheck HTTP du worker (/api/health).
WORKER_HEALTH_PORT=3001
# Exécute `prisma migrate deploy` au démarrage du worker (true dans le compose).
RUN_MIGRATIONS=false

# ── Web ──────────────────────────────────────────────────────
# Dossier de stockage des photos de collection (volume Docker en production).
UPLOAD_DIR=./uploads
